# Stage 1: samo production ovisnosti
FROM node:22-alpine AS prod-deps
WORKDIR /app
COPY package*.json ./
RUN npm install --omit=dev

# Stage 2: development (hot-reload kroz nodemon)
FROM node:22-alpine AS dev
WORKDIR /app
COPY package*.json ./
RUN npm install
COPY src/ ./src/
CMD ["npm", "run", "dev"]

# Stage 3: production runtime — minimalna slika, non-root korisnik
FROM node:22-alpine AS production
WORKDIR /app
RUN addgroup -S -g 1001 app && adduser -S -u 1001 -G app app
COPY --from=prod-deps /app/node_modules ./node_modules
COPY src/ ./src/
USER app
EXPOSE 3000
CMD ["node", "src/server.js"]
